DATABASE_URL=postgresql+psycopg://dealfinder:dealfinder@localhost:5432/dealfinder
REDIS_URL=redis://localhost:6379/0

# eBay Browse API (developer.ebay.com), sandbox first, swap to production once verified
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# systems/scheduler.py: how often each job type gets enqueued, in seconds.
# Ingest is 2-hourly, not hourly: halving its cost roughly doubles how many
# saved searches fit the same quota, and breadth finds more deals than
# polling the same searches twice as often.
INGEST_INTERVAL_SECONDS=7200
DISAPPEARANCE_CHECK_INTERVAL_SECONDS=21600

# Call budgeting (docs/decisions/0003-ebay-call-budget.md). eBay allows 5,000
# Browse calls/day, shared between search and get_item, so the disappearance
# check has to live inside a budget instead of sweeping everything.
# Listings a saved search saw recently are skipped for free.
# Sized so ingest (64 x 12 = 768) plus checking (700 x 4 = 2,800) = 3,568 of 5,000.
# QUOTA_RESERVE must stay ABOVE a full day of ingest (768) and well BELOW
# 5000 - 768 - 2800, or the checker silently halts partway through the day.
DISAPPEARANCE_CHECK_BUDGET=700
QUOTA_RESERVE=1000
# MUST stay comfortably above INGEST_INTERVAL_SECONDS (a test enforces 1.5x).
# Drop below it and every listing expires between ingest runs, the whole
# corpus becomes check candidates every pass, and the budget stops meaning
# anything. That failure is silent, which is why it's tested.
PROVEN_ALIVE_SECONDS=10800

# Retire listings that never sell and never end, so the check set stays bounded.
# Conservative on purpose: retiring too early quietly costs comp data.
STALE_AFTER_DAYS=60
UNSEEN_AFTER_DAYS=30

# CLIP embeddings (docs/decisions/0009-clip-embeddings-pgvector.md).
# The model name and its dimension are deliberately NOT configurable: they
# have to agree with the column the migration created. See ml/embeddings.py.
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=64
EMBED_JOB_MAX_LISTINGS=2000
EMBED_INTERVAL_SECONDS=900

# Deal feed and alerting (docs/decisions/0014, 0015). BOTH thresholds apply
# together: a big discount from two shaky comps is the likeliest thing to be
# wrong, and is what an unfiltered "biggest discounts" list surfaces first.
DEAL_MIN_SCORE=0.2
DEAL_MIN_CONFIDENCE=0.3
DEAL_FEED_SIZE=50
DEAL_SCAN_INTERVAL_SECONDS=3600
# Leave empty to disable alerting entirely, which is the default.
DISCORD_WEBHOOK_URL=
DISCORD_MAX_ALERTS=5

# Valuation (docs/decisions/0014-valuation-and-deal-scoring.md).
# A comp below MIN_SALE_CONFIDENCE is excluded outright, not down-weighted.
# Below MIN_COMPS_FOR_VALUATION comps, no estimate is produced at all, which
# is currently about a third of listings and is the intended behaviour.
MIN_SALE_CONFIDENCE=0.3
MIN_COMPS_FOR_VALUATION=3

# Only used by tests that need real Postgres (pgvector distance operators).
# They skip, rather than fail, when this is unreachable.
# Create it once with:
#   docker exec infra-postgres-1 createdb -U dealfinder dealfinder_test
TEST_DATABASE_URL=postgresql+psycopg://dealfinder:dealfinder@localhost:5432/dealfinder_test
