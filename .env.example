DATABASE_URL=postgresql+psycopg://dealfinder:dealfinder@localhost:5432/dealfinder
REDIS_URL=redis://localhost:6379/0

# eBay Browse API (developer.ebay.com), sandbox first, swap to production once verified
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# systems/scheduler.py: how often each job type gets enqueued, in seconds
INGEST_INTERVAL_SECONDS=3600
DISAPPEARANCE_CHECK_INTERVAL_SECONDS=21600

# Call budgeting (docs/decisions/0003-ebay-call-budget.md). eBay allows 5,000
# Browse calls/day, shared between search and get_item, so the disappearance
# check has to live inside a budget instead of sweeping everything.
# Listings a saved search saw recently are skipped for free.
# Sized so ingest (64 x 24 = 1,536) plus checking (700 x 4 = 2,800) = 4,336 of 5,000.
DISAPPEARANCE_CHECK_BUDGET=700
QUOTA_RESERVE=2000
PROVEN_ALIVE_SECONDS=7200

# Retire listings that never sell and never end, so the check set stays bounded.
# Conservative on purpose: retiring too early quietly costs comp data.
STALE_AFTER_DAYS=60
UNSEEN_AFTER_DAYS=30
