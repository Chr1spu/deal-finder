# The dashboard: built with vite, served by nginx, /api proxied to the API.
#
# The proxy is the same arrangement vite's dev server uses (frontend/vite.config.js),
# and for the same reason: the browser then makes same-origin requests, so CORS
# never enters the picture and no fetch URL differs between dev and production.
# api/main.py's CORS list stays what it is for, which is the browser extension.

FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
# `npm ci` needs the lockfile to match package.json exactly, which is what
# makes it reproducible where `npm install` is not.
RUN npm ci

COPY frontend/ ./
RUN npm run build


FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
